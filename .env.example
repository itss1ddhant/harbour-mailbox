# Copy this file to .env and fill it in. The .env file is never committed.

# Local development: the database is a file inside the project. Nothing to install.
DATABASE_URL=file:./data/harbour.db

# Only needed for a hosted database (Turso). Leave empty locally.
DATABASE_AUTH_TOKEN=

# Demo account passwords. Choose your own, at least 8 characters each, a different one
# for each person. `npm run db:setup` and `npm run db:reset` read these when they create
# the demo accounts; the database stores only a hash of each. The running app does not
# read them. After changing one, run `npm run db:reset`.
# Staff
DEMO_PASSWORD_MAYA=
DEMO_PASSWORD_LEO=
DEMO_PASSWORD_PRIYA=
DEMO_PASSWORD_TOM=
DEMO_PASSWORD_AISHA=
DEMO_PASSWORD_DANIEL=
DEMO_PASSWORD_BEN=
DEMO_PASSWORD_GRACE=
# Clients
DEMO_PASSWORD_ELENA=
DEMO_PASSWORD_OLIVER=
DEMO_PASSWORD_SAM=
DEMO_PASSWORD_NOOR=
